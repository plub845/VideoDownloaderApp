# ==============================================================================
# .gitignore - VideoDownloaderApp
# ==============================================================================

# Build & Compilation Outputs
[Bb]in/
[Oo]bj/
VideoDownloaderApp/bin/
VideoDownloaderApp/obj/
VideoDownloaderApp.Linux/bin/
VideoDownloaderApp.Linux/obj/

# Publish Directories (Never commit built binaries)
[Pp]ublish/
publish/
VideoDownloaderApp/publish/
VideoDownloaderApp.Linux/publish/

# Compiled Executables, Libraries & Archives (SignPath Foundation Compliance)
*.exe
*.dll
*.so
*.dylib
*.pdb
*.deb
*.rpm
*.AppImage
*.snap
*.msi
*.zip
*.tar.gz

# Pre-bundled binaries in VideoDownloaderApp/main
VideoDownloaderApp/main/*.exe
VideoDownloaderApp/main/*.dll
VideoDownloaderApp/main/*.pdb
VideoDownloaderApp/main/*.deps.json
VideoDownloaderApp/main/*.runtimeconfig.json

# Installer build outputs (keep scripts like .iss, .sh, .ps1, and bitmaps)
installer/*.exe
installer/*.msi
installer/*.deb
installer/*.zip

# IDE & OS Files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
.idea/
.vscode/
Thumbs.db
.DS_Store

# Linux Packaging Temporary Artifacts
VideoDownloaderApp.Linux/.craft/
VideoDownloaderApp.Linux/parts/
VideoDownloaderApp.Linux/prime/
VideoDownloaderApp.Linux/stage/
VideoDownloaderApp.Linux/packaging/root/
VideoDownloaderApp.Linux/packaging/dist/
VideoDownloaderApp.Linux/packaging/publish/
